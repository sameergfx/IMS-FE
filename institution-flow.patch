diff --git a/src/features/institutions/components/InstitutionGuard.tsx b/src/features/institutions/components/InstitutionGuard.tsx
new file mode 100644
index 0000000..f55358c
--- /dev/null
+++ b/src/features/institutions/components/InstitutionGuard.tsx
@@ -0,0 +1,67 @@
+"use client";
+
+import { useEffect, useState } from "react";
+import { useRouter } from "next/navigation";
+
+import { useAppDispatch, useAppSelector } from "@/store/hooks";
+import { selectInstitution } from "@/store/slices/institutionSlice";
+import { institutionStorage } from "@/lib/cookies";
+import { getInstitutionById } from "../api/institution.api";
+
+/**
+ * Ensures a selected institution exists in Redux state for anything
+ * rendered under the dashboard layout. Falls back to re-fetching the
+ * institution from the cookie-stored id on a hard refresh, and sends
+ * the user back to /institutions if nothing is selected.
+ */
+export default function InstitutionGuard({
+  children,
+}: {
+  children: React.ReactNode;
+}) {
+  const dispatch = useAppDispatch();
+  const router = useRouter();
+
+  const selectedInstitution = useAppSelector(
+    (state) => state.institution.selectedInstitution
+  );
+
+  const [status, setStatus] = useState<"pending" | "ready">("pending");
+
+  useEffect(() => {
+    if (selectedInstitution) {
+      return;
+    }
+
+    const institutionId = institutionStorage.get();
+
+    if (!institutionId) {
+      router.replace("/institutions");
+      return;
+    }
+
+    getInstitutionById(institutionId)
+      .then((institution) => {
+        dispatch(selectInstitution(institution));
+      })
+      .catch(() => {
+        institutionStorage.clear();
+        router.replace("/institutions");
+      })
+      .finally(() => {
+        setStatus("ready");
+      });
+  }, [selectedInstitution, dispatch, router]);
+
+  const ready = Boolean(selectedInstitution) || status === "ready";
+
+  if (!ready) {
+    return (
+      <div className="flex h-screen items-center justify-center">
+        <p className="text-slate-500">Loading institution...</p>
+      </div>
+    );
+  }
+
+  return <>{children}</>;
+}
