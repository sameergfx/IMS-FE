diff --git a/src/store/slices/institutionSlice.ts b/src/store/slices/institutionSlice.ts
index e69de29..30a516d 100644
--- a/src/store/slices/institutionSlice.ts
+++ b/src/store/slices/institutionSlice.ts
@@ -0,0 +1,41 @@
+import { createSlice, PayloadAction } from "@reduxjs/toolkit";
+import type { Institution, InstitutionState } from "@/features/institutions/types/institution";
+
+const initialState: InstitutionState = {
+  institutions: [],
+  selectedInstitution: null,
+  loading: false,
+};
+
+const institutionSlice = createSlice({
+  name: "institution",
+
+  initialState,
+
+  reducers: {
+    setInstitutions(state, action: PayloadAction<Institution[]>) {
+      state.institutions = action.payload;
+    },
+
+    selectInstitution(state, action: PayloadAction<Institution>) {
+      state.selectedInstitution = action.payload;
+    },
+
+    clearSelectedInstitution(state) {
+      state.selectedInstitution = null;
+    },
+
+    setInstitutionLoading(state, action: PayloadAction<boolean>) {
+      state.loading = action.payload;
+    },
+  },
+});
+
+export const {
+  setInstitutions,
+  selectInstitution,
+  clearSelectedInstitution,
+  setInstitutionLoading,
+} = institutionSlice.actions;
+
+export default institutionSlice.reducer;
