+"use client";
+
+import { Building2 } from "lucide-react";
+
+import { useInstitutions } from "@/features/institutions/hooks/useInstitutions";
+import { useSelectInstitution } from "@/features/institutions/hooks/useSelectInstitution";
+import InstitutionCard from "@/features/institutions/components/InstitutionCard";
+import { useLogout } from "@/features/auth/hooks/useLogout";
+import { useAppSelector } from "@/store/hooks";
+
+export default function InstitutionsPage() {
+  const { data: institutions, isLoading, isError } = useInstitutions();
+  const selectAndEnter = useSelectInstitution();
+  const logout = useLogout();
+  const user = useAppSelector((state) => state.auth.user);
+
+  return (
+    <main className="min-h-screen bg-slate-50">
+      <header className="h-14 bg-white border-b flex items-center justify-between px-6">
+        <div className="flex items-center gap-2 font-semibold text-slate-800">
+          <Building2 size={20} className="text-blue-900" />
+          School ERP
+        </div>
+
+        <div className="flex items-center gap-4">
+          {user && (
+            <span className="text-sm text-slate-500">{user.full_name}</span>
+          )}
+          <button onClick={logout} className="text-sm text-red-600">
+            Logout
+          </button>
+        </div>
+      </header>
+
+      <div className="mx-auto max-w-5xl px-6 py-10">
+        <h1 className="text-2xl font-semibold text-slate-800">
+          Select an institution
+        </h1>
+        <p className="mt-1 text-sm text-slate-500">
+          Choose the institution you want to manage.
+        </p>
+
+        {isLoading && (
+          <div className="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
+            {Array.from({ length: 3 }).map((_, i) => (
+              <div
+                key={i}
+                className="h-40 animate-pulse rounded-xl border bg-white"
+              />
+            ))}
+          </div>
+        )}
+
+        {isError && (
+          <div className="mt-8 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-600">
+            Couldn&apos;t load institutions. Please try again.
+          </div>
+        )}
+
+        {!isLoading && !isError && institutions?.length === 0 && (
+          <div className="mt-8 rounded-xl border bg-white p-6 text-sm text-slate-500">
+            No institutions are linked to your account yet.
+          </div>
+        )}
+
+        {!isLoading && !isError && institutions && institutions.length > 0 && (
+          <div className="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
+            {institutions.map((institution) => (
+              <InstitutionCard
+                key={institution.id}
+                institution={institution}
+                onSelect={selectAndEnter}
+              />
+            ))}
+          </div>
+        )}
+      </div>
+    </main>
+  );
+}
