diff --git a/middleware.ts b/middleware.ts
index f167d73..d018271 100644
--- a/middleware.ts
+++ b/middleware.ts
@@ -1,18 +1,43 @@
 import { NextRequest, NextResponse } from "next/server";
 
+const DASHBOARD_PREFIXES = [
+  "/dashboard",
+  "/students",
+  "/teachers",
+  "/members",
+  "/staffs",
+  "/invoices",
+  "/accounting",
+  "/settings",
+];
+
 export function middleware(request: NextRequest) {
   const token = request.cookies.get("access_token")?.value;
+  const institutionId = request.cookies.get("selected_institution_id")?.value;
 
   const { pathname } = request.nextUrl;
 
   const isAuthPage = pathname === "/login";
+  const isDashboardRoute = DASHBOARD_PREFIXES.some(
+    (prefix) => pathname === prefix || pathname.startsWith(`${prefix}/`)
+  );
 
   if (!token && !isAuthPage) {
     return NextResponse.redirect(new URL("/login", request.url));
   }
 
   if (token && isAuthPage) {
-    return NextResponse.redirect(new URL("/dashboard", request.url));
+    return NextResponse.redirect(new URL("/institutions", request.url));
+  }
+
+  if (token && !institutionId && isDashboardRoute) {
+    return NextResponse.redirect(new URL("/institutions", request.url));
+  }
+
+  if (token && pathname === "/") {
+    return NextResponse.redirect(
+      new URL(institutionId ? "/dashboard" : "/institutions", request.url)
+    );
   }
 
   return NextResponse.next();
